<!--
  Backing store + defaults for Application.Properties.getValue(...). Note
  the string defaults are plain text, not JSON/quoted — a literal `""`
  here would set the *value* to the two characters `""`, not an empty
  string. AgonLiveScoringApp.nonEmpty() is what actually treats "unset" as
  null for the empty ones (matchId/homeSideId/awaySideId/pairingCode).
-->
<properties>
    <property id="pairingCode" type="string"></property>
    <property id="apiBaseUrl" type="string">https://api.get-agon.com</property>
    <property id="matchId" type="string"></property>
    <property id="homeSideId" type="string"></property>
    <property id="awaySideId" type="string"></property>
</properties>
