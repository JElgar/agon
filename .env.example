# ── JWT auth (asymmetric) ──────────────────────────────────────────────────
# Tokens are verified against public keys — never a shared secret. The service
# trusts two sources (either alone is fine; set what you need):
#   SUPABASE_JWKS_URL  — Supabase's JWKS endpoint for real user tokens.
#   AGON_STATIC_JWKS   — a JSON JWK Set of always-trusted public keys. Used to
#                        trust the test/local signing key below.
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
#
# Running against the local Supabase Auth stack instead (docker-compose.yml
# — see agon_ui/e2e/README.md's "Running fully local" section)? Point
# SUPABASE_JWKS_URL at it instead of a real project:
# SUPABASE_JWKS_URL=http://localhost:8000/auth/v1/.well-known/jwks.json
#
# `agon_tests` needs a trusted signing key — this is what AGON_STATIC_JWKS is
# for: a fixed, dev-only ES256 keypair (generated for this repo, not used
# anywhere real — same spirit as MEILI_MASTER_KEY below). Uncomment to enable
# it (its matching private half is local/agon-test-key.pem — the Makefile
# wires that in as AGON_TEST_JWT_PRIVATE_KEY automatically, see Makefile; it
# isn't set here because a real multi-line PEM can't live in this file — see
# that Makefile comment for why).
# AGON_STATIC_JWKS={"keys":[{"kty":"EC","crv":"P-256","alg":"ES256","use":"sig","kid":"agon-test","x":"hByszAPunzKyi0KKx0sSxYaxok09LVKsDEA5_csKClQ","y":"6vk3GeZNAG7f0eYASrYVgfe4dUtUS4wYteGVVw62N9Q"}]}
# AGON_TEST_JWT_KID=agon-test

AGON_SERVICE_URL=http://localhost:7000

# DynamoDB single table + AWS creds (the service and worker read these). Real/
# cloud by default — set real credentials for AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY, or run against DynamoDB Local instead (`docker
# compose up -d` creates this table — schema mirrored from agon_infra/index.ts,
# see local/dynamodb/): uncomment AWS_ENDPOINT_URL below. Either way the
# values here (region, fake local creds) are needed — DynamoDB Local doesn't
# validate them, but the same pair is shared by every local AWS service,
# including MinIO (see Object storage below), which *does* validate — hence
# `localsecret` rather than a shorter placeholder (MinIO requires 8+ chars).
AGON_TABLE_NAME=agon
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=localsecret
# AWS_ENDPOINT_URL=http://localhost:8002

# Meilisearch (discovery/search endpoints). Matches docker-compose.
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKeyForLocalDevOnly

# ── agon_worker ──────────────────────────────────────────────────────────
# Not needed to run agon_service or agon_ui — only agon_worker (`make
# run-worker`). All of these are required (a failed connection / missing var
# is fatal) — there's no way to run agon_worker with only some of this set.
#
# Temporal — agon_worker/src/temporal (feed fan-out, accept-invitation
# sagas). Matches docker-compose.yml's `temporal` service.
TEMPORAL_ADDRESS=localhost:7233
#
# The two SQS queues agon_worker long-polls — see agon_worker/src/config.rs.
# Real/cloud (from Pulumi) by default; for local queues instead (ElasticMQ,
# see local/dynamodb/create-queues.sh), uncomment all three lines below this
# one (queue URLs + AWS_ENDPOINT_URL_SQS). Note this is *in addition* to
# AWS_ENDPOINT_URL above (for DynamoDB) — the two are independent per-service
# overrides sharing one set of AWS creds, not a replacement for each other.
AGON_EVENTS_QUEUE_URL=
AGON_ASSET_EVENTS_QUEUE_URL=
# AGON_EVENTS_QUEUE_URL=http://localhost:9324/000000000000/agon-events
# AGON_ASSET_EVENTS_QUEUE_URL=http://localhost:9324/000000000000/agon-asset-events
# AWS_ENDPOINT_URL_SQS=http://localhost:9324
#
# AGON_EVENTS_QUEUE_URL only actually receives anything locally if
# local/dynamodb-stream-bridge (`make run-stream-bridge`) is also running —
# see local/README.md for why. That tool needs its own separate endpoint
# override (a *different* AWS service — DynamoDB Streams, not DynamoDB) to
# find the local table's stream:
# AWS_ENDPOINT_URL_DYNAMODB_STREAMS=http://localhost:8002
#
# agon_worker also requires AGON_ASSETS_CDN_URL below to be set to
# *something* to start at all — uncomment it too. Locally that "something"
# can be real (see the Object Storage section below): agon-asset-events just
# never receives anything either way, since nothing here generates real S3
# object-created events the way S3 -> EventBridge -> SQS does in production.

# ── Object storage: image uploads (profile / team / match) ─────────────────
# Private S3 bucket the service issues presigned PUTs against, and the base CDN
# URL images are served from. In the cluster these are injected from Pulumi
# (see agon_infra); set them locally only if exercising the upload flow —
# either real S3 (real credentials, leave the two lines below commented), or
# local (MinIO — creates the bucket too; see local/dynamodb/) by uncommenting
# them.
AGON_ASSETS_BUCKET=agon-assets
# Real S3 presigned URLs are virtual-hosted-style (`<bucket>.<endpoint>`);
# MinIO has no wildcard DNS for that, so its presigned URLs need path-style
# instead — this is what actually switches that, not just an endpoint
# override. Never set outside local dev.
# AGON_ASSETS_S3_FORCE_PATH_STYLE=1
# AWS_ENDPOINT_URL_S3=http://localhost:9000
# CloudFront (or other CDN) base URL, no trailing slash. The service builds
# public serving URLs and signs match-header URLs against this; the worker
# stores the canonical URL on an asset when it uploads.
# AGON_ASSETS_CDN_URL=https://dxxxx.cloudfront.net
# AGON_ASSETS_CDN_URL=http://localhost:9000/agon-assets
# CloudFront signed-URL key pair for match-header serving. Only set to enable
# signing; when unset the service serves match headers unsigned (dev).
# AGON_CLOUDFRONT_KEY_PAIR_ID=
# AGON_CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Push notifications (FCM). The worker sends a push whenever a notification is
# created. Optional — unset means push is disabled (no GCP project needed for
# local dev); set it to the verbatim JSON of a GCP service-account key with the
# "Firebase Cloud Messaging API Admin" role to enable it.
# AGON_FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# The web app's public URL, used to build the link a push notification opens
# (e.g. https://agon.staging.get-agon.com/matches/abc123). Optional — unset
# just means push notifications open the app with no deep link.
# AGON_UI_URL=https://agon.staging.get-agon.com

# Observability (OTLP export of logs, traces, metrics). See docs/observability.md.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT UNSET for local dev — the apps then log JSON
# to stdout only and skip all export (no collector needed). Point it at an OTLP
# collector (Grafana Alloy in the cluster) to enable export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=agon-service   # set per-binary; the code passes a default
