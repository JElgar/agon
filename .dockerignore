# Rust build artifacts — rebuilt inside the image, never copy the host's.
target/

# Node / infra tooling not needed by the Rust image builds.
**/node_modules/
agon_infra/
agon_ui/

# agon_tests is tracked in git but isn't a workspace member built by either
# image (see root Cargo.toml `exclude`) — excluded here purely to keep it out
# of the build context, not because it's absent.
agon_tests/

# openapi_client/ and schema.json are gitignored (generated by
# `make generate-schema`) so they're normally absent from a checkout anyway;
# listed here too so a local build context that happens to have them
# (a dev machine that ran `make build`) doesn't pick them up either.
openapi_client/
schema.json

# Docs/CI/VCS/editor cruft — irrelevant to the compiled binaries, but still
# part of the build context, so a docs-only change would otherwise bust the
# final COPY layer for no reason.
.github/
docs/
*.md

# Local env / VCS / editor cruft.
.git/
.env
**/*.log
