<!--
  App id below is a placeholder — replace with the id assigned when you
  register this app at https://apps.garmin.com/developer (Connect IQ
  developer portal). launcherIcon is omitted: this sandbox can't produce a
  binary PNG asset — add resources/drawables/launcher_icon.png and wire it
  in (launcherIcon="@Drawables.LauncherIcon") before building for real.
  Device list is a starting point (WiFi-capable, ActivityRecording +
  Communications-capable models) — trim/extend to whatever you're actually
  testing on.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="AgonLiveScoringApp"
        id="00000000-0000-0000-0000-000000000000"
        minSdkVersion="4.2.0"
        name="@Strings.AppName"
        type="watch-app"
        version="0.1.0">
        <iq:products>
            <iq:product id="fenix7"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fr955"/>
            <iq:product id="epix2"/>
            <iq:product id="fenix8solar47mm"/>
        </iq:products>
        <iq:permissions>
            <!-- POST/GET against agon_service. -->
            <iq:uses-permission id="Communications"/>
            <!-- ActivityRecording's GPS track. -->
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
