# Installed fresh inside the image by `npm ci` — copying the host's (already
# installed here by the CI step that runs `npm run generate` before `docker
# build`) into the build context bloats it and overwrites the image's own
# install with whatever the host happens to have on disk.
node_modules/

# Build outputs — regenerated by the Dockerfile itself.
dist/
dist-ssr/

# Not needed by the build, but still part of the context otherwise, so an
# unrelated change here would bust the final `COPY . /app/` layer for no
# reason.
.git/
e2e/
playwright-report/
test-results/
coverage/
README.md
*.log
.env
.env.*
!.env.example
