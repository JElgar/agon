<!--
  App Settings schema — edited from Garmin Connect Mobile's per-app
  settings screen (phone keyboard, not the watch's buttons), synced to the
  device and readable via Application.Properties. See
  AgonLiveScoringApp.mc's onSettingsChanged for what happens when
  pairingCode changes.
-->
<settings>
    <setting propertyKey="@Properties.pairingCode" title="@Strings.SettingsPairingCode">
        <settingConfig type="alphaNumeric" maxLength="6"/>
    </setting>
    <setting propertyKey="@Properties.apiBaseUrl" title="@Strings.SettingsApiBaseUrl">
        <settingConfig type="alphaNumeric" maxLength="128"/>
    </setting>
    <setting propertyKey="@Properties.matchId" title="@Strings.SettingsMatchId">
        <settingConfig type="alphaNumeric" maxLength="32"/>
    </setting>
    <setting propertyKey="@Properties.homeSideId" title="@Strings.SettingsHomeSideId">
        <settingConfig type="alphaNumeric" maxLength="32"/>
    </setting>
    <setting propertyKey="@Properties.awaySideId" title="@Strings.SettingsAwaySideId">
        <settingConfig type="alphaNumeric" maxLength="32"/>
    </setting>
</settings>
