VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Fully local dev/e2e (optional) ──────────────────────────────────────────
# Point the UI at the local Supabase Auth + agon_service stack (docker-compose
# .yml's `full` profile) instead of staging. See e2e/README.md's "Running
# fully local" section. Leave commented to keep the default: staging Supabase
# + `/api` proxied to staging (see vite.config.ts).
# VITE_SUPABASE_URL=http://localhost:8000
# VITE_SUPABASE_ANON_KEY=local-dev-anon-key
# AGON_API_PROXY_TARGET=http://localhost:7000
